# ============================================================
# REQUIRED — the panel refuses to start without these.
# ============================================================

# The single admin login. There is no user table behind this panel and no
# sign-up: whoever holds these two values is the administrator. Change them
# per deployment and never reuse the CRM's own credentials.
#
# The username is compared case-insensitively, the password exactly. Both
# comparisons are timing-safe, so a wrong password leaks nothing about how
# much of it was right.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Signs the session cookie (HS256 JWT). 32+ bytes. Generate with:
#   openssl rand -base64 48
# Rotating this logs everyone out immediately — that is the intended
# "revoke all sessions" button.
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Postgres connection. Same database the api uses — copy DATABASE_URL out of
# apps/api/.env verbatim. The panel reads and writes subscription rows
# directly through Prisma (@repo/database owns the schema); it never calls
# the NestJS api.
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public

# ============================================================
# OPTIONAL — sensible defaults, override when they don't fit.
# ============================================================

# Currency the plan prices are denominated in. subscription_plans stores bare
# decimals with no currency column, so this is what every amount in the panel
# is formatted as. Defaults to INR (what the live plans are priced in).
# ADMIN_CURRENCY=INR

# How long a login lasts, in hours. Default 12 — short on purpose, this panel
# can change what customers are billed.
# ADMIN_SESSION_TTL_HOURS=12

# Ceiling on one manual AI credit adjustment, in either direction. A
# server-side backstop that does not depend on the form's own validation —
# granting credits costs us inference on the platform Gemini key that the
# customer never paid for. Default 25000, the size of the largest pack anyone
# can actually buy: going above what is purchasable should take an env change.
# ADMIN_MAX_CREDIT_ADJUSTMENT=25000
