# ============================================================
# REQUIRED
# ============================================================

# Session-mode Supavisor pooler connection string for the `prisma`
# role (see prisma/bootstrap-role.sql — run that SQL once in the
# Supabase SQL editor first, then paste the resulting password here).
# Port 5432, NOT 6543 — this is a persistent Node process, not
# serverless, so no separate DIRECT_URL is needed.
DATABASE_URL="postgres://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?connection_limit=10"

# Same Supabase project apps/web already points at (Project Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Reserved for Phase 1+ (Storage/Realtime admin access from apps/api).
# Not used by anything in Phase 0.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Confirmed via live testing: this project uses asymmetric ES256
# signing keys (Supabase Dashboard -> Settings -> API -> JWT Settings)
# — no secret needed, SupabaseAuthGuard fetches the public JWKS
# instead. Only set SUPABASE_JWT_SECRET (and switch this to HS256) if
# a future/other project uses the legacy shared-secret setup instead.
SUPABASE_JWT_ALG=ES256
# SUPABASE_JWT_SECRET=your-jwt-secret

# WhatsApp token encryption key (Automations domain, Phase 1) — must be
# the SAME 64-hex-char key apps/web uses, since it decrypts
# whatsapp_config.access_token rows encrypted by apps/web.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Shared secret for the apps/web -> apps/api server-to-server bridge
# (e.g. the WhatsApp webhook's automations dispatch call). Generate with:
#   openssl rand -hex 32
# Must match apps/web's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=generate-a-long-random-string

# ============================================================
# DOMAIN INTEGRATIONS (Phases 4–5) — set the ones you use
# ============================================================

# Meta (WhatsApp/Facebook) app credentials. META_APP_SECRET is REQUIRED
# for inbound WhatsApp webhooks — signature verification fails closed
# without it, so Meta's POSTs get rejected.
# META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# App-level WhatsApp webhook verify token. Any random string; must match
# the "Verify token" field in Meta → WhatsApp → Configuration → Webhook
# exactly. Generate with:
#   openssl rand -hex 16
#
# ⚠️ REQUIRED for the Tech Provider / Embedded Signup model. The webhook
# is configured ONCE at app level and we subscribe our app to each
# customer's WABA afterwards, so Meta's handshake carries a token that
# belongs to the app rather than to any one account.
#
# Without it a fresh deployment deadlocks: zero connected accounts means
# no per-account token to match, so the handshake 403s, so the Meta
# dashboard refuses to save the webhook, so no account can ever connect.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

# Public base URL of the dashboard — used for OAuth redirect URIs
# (Shopify callback, Facebook connect) and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay billing (subscription checkout + POST /webhooks/razorpay).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Stripe billing (checkout session + POST /webhooks/stripe).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shopify OAuth (ecommerce integration).
# SHOPIFY_CLIENT_ID=your-shopify-client-id
# SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Facebook Lead Ads webhook GET-challenge verify token.
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-verify-token
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ------------------------------------------------------------
# Instagram DMs + comment moderation (Instagram Login)
#
# ⚠️ THESE ARE NOT THE SAME VALUES AS META_APP_ID / META_APP_SECRET —
# but they are NOT a separate app either. Meta generates a second
# credential pair INSIDE the same app, shown at:
#   Meta → your app → Instagram → API setup with Instagram login
# Meta signs Instagram webhooks with the *Instagram* secret. Using
# META_APP_SECRET here rejects 100% of inbound webhooks, with no
# symptom other than messages never arriving.
#
# Do NOT create a second Meta app for Instagram: ig_scoped_id is
# app-scoped, so migrating apps invalidates every stored Instagram
# identity. See docs/meta-platform-setup.md §0.
# ------------------------------------------------------------
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Any random string. Must match the "Verify token" field in
# Meta → Instagram → Webhooks exactly. Generate with:
#   openssl rand -hex 16
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-verify-token

# Must be registered under Business login settings → OAuth Redirect URI.
# Points at the API (not the web app) — same as the webhook.
# INSTAGRAM_REDIRECT_URI=https://your-api-domain/instagram/connect/callback

# Graph version for graph.instagram.com. Pinned so a deprecation is a
# config change, not a deploy.
# INSTAGRAM_API_VERSION=v23.0

# Meta's Human Agent permission extends the reply window from 24 hours
# to 7 days. It is a SEPARATE App Review. Leave false until approved —
# turning it on without approval just makes sends fail at the API.
# INSTAGRAM_HUMAN_AGENT_ENABLED=false

# ============================================================
# RECOMMENDED — safe defaults for local dev
# ============================================================

# docker-compose up starts this at the root of the repo.
REDIS_URL=redis://localhost:6379

PORT=8001
NODE_ENV=development

# BullMQ automations-pending worker concurrency (default 5 if unset).
# AUTOMATIONS_WORKER_CONCURRENCY=5

# ------------------------------------------------------------
# Queue dashboard (Bull Board) — off unless BOTH are set.
#
# ⚠️ It shows job payloads for EVERY tenant, so it is deliberately not
# tied to a workspace login: a workspace admin is an admin of ONE
# workspace. Treat these like the admin-panel credentials.
#
# Mounted at /admin/queues. Basic auth sends the password in the clear,
# so only ever reach it through the TLS-terminating proxy — the API
# binds to 127.0.0.1 in docker-compose for exactly this reason.
# ------------------------------------------------------------
# QUEUE_DASHBOARD_USER=ops
# QUEUE_DASHBOARD_PASSWORD=

# ------------------------------------------------------------
# Broadcast delivery (fan-out queue)
# ------------------------------------------------------------

# Messages per second across the whole instance, not per phone number:
# BullMQ's open-source limiter is per queue. Default 10 = Meta's Tier 1
# ceiling, which every new WABA starts on. Raise only once the numbers
# sending through this deployment are on a higher tier.
# BROADCAST_SEND_RATE_MAX=10
# BROADCAST_SEND_RATE_DURATION_MS=1000

# Recipient sends in flight at once (default 10).
# BROADCAST_SEND_CONCURRENCY=10

# ------------------------------------------------------------
# AI auto-reply
# ------------------------------------------------------------

# Simultaneous provider calls (default 20). This number IS the bot's
# response time under load: a reply that waits for a free slot is a
# customer watching nothing happen. If /admin/queues ever shows the
# ai-reply queue with jobs waiting, raise this.
# AI_REPLY_CONCURRENCY=20

# Flows stale-run sweep interval in ms (default 5 min).
# FLOWS_SWEEP_INTERVAL_MS=300000

# AI reply tuning + template dry-run switch.
# AI_CONTEXT_MESSAGE_LIMIT=20
# AI_REQUEST_TIMEOUT_MS=30000
# WHATSAPP_TEMPLATES_DRY_RUN=false

# ============================================================
# META ADS MANAGER (apps/api/src/ads) — OFF BY DEFAULT
#
# Setup checklist and open decisions:
#   docs/meta-ads-manager-requirements.md
# Design:
#   docs/meta-ads-manager.md
# ============================================================

# Master switch. Off (the default) → every /ads/* route 404s, via
# AdsEnabledGuard. Leave false until Meta App Review has approved
# `ads_management` for this app — a half-connected ads screen on a
# paying customer's dashboard is worse than no screen.
ADS_MANAGER_ENABLED=false

# Serve fixtures instead of calling Meta (src/ads/sandbox/fixtures.ts).
# The escape hatch that makes the App Review screencast possible before
# App Review, mirroring the `isDemo` path in the Facebook lead-ads
# integration. Proves our code paths, NOT Meta's parameter validation.
ADS_MANAGER_SANDBOX=true

# Optional. Omit BOTH to reuse META_APP_ID / META_APP_SECRET above,
# which is the default and usually what you want: the customer has
# already granted that app Pages and WhatsApp access, so adding ads
# scopes is an incremental permission request rather than a second
# full login.
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=

# Where Meta sends the browser back after consent. Must match a Valid
# OAuth Redirect URI in the Meta app dashboard EXACTLY — a mismatch
# fails with "Invalid redirect_uri", which names neither the expected
# value nor where to put it. GET /ads/oauth/config echoes whatever this
# server will actually send, so you can copy-paste it.
META_ADS_REDIRECT_URI=http://localhost:8001/ads/oauth/callback

# Server-side daily-budget ceiling, in MINOR units of the ad account's
# currency (1000000 = ₹10,000/day). A backstop, not a product limit:
# budgets travel as minor units from the wizard all the way to Graph, so
# one missed conversion is a 100× overspend on a real customer's card.
# ADS_MAX_DAILY_BUDGET_MINOR=1000000

# WhatsApp Status ads — OFF, and separately from the master switch.
#
# The `whatsapp_positions: ['status']` placement is new, market-gated, has
# no example in Meta's Postman collection, and is unverified against a real
# ad account. Every other ad type ships without it, so it gets its own
# switch: the wizard renders the card disabled with a reason until someone
# confirms the placement exists for the target ad accounts.
# See docs/meta-ads-manager-requirements.md §4.
ADS_WHATSAPP_STATUS_ENABLED=false
