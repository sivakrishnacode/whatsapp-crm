# ============================================================
# REQUIRED
# ============================================================

# Session-mode Supavisor pooler connection string for the `prisma`
# role (see prisma/bootstrap-role.sql — run that SQL once in the
# Supabase SQL editor first, then paste the resulting password here).
# Port 5432, NOT 6543 — this is a persistent Node process, not
# serverless, so no separate DIRECT_URL is needed.
DATABASE_URL="postgres://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?connection_limit=10"

# Same Supabase project apps/web already points at (Project Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Reserved for Phase 1+ (Storage/Realtime admin access from apps/api).
# Not used by anything in Phase 0.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Confirmed via live testing: this project uses asymmetric ES256
# signing keys (Supabase Dashboard -> Settings -> API -> JWT Settings)
# — no secret needed, SupabaseAuthGuard fetches the public JWKS
# instead. Only set SUPABASE_JWT_SECRET (and switch this to HS256) if
# a future/other project uses the legacy shared-secret setup instead.
SUPABASE_JWT_ALG=ES256
# SUPABASE_JWT_SECRET=your-jwt-secret

# WhatsApp token encryption key (Automations domain, Phase 1) — must be
# the SAME 64-hex-char key apps/web uses, since it decrypts
# whatsapp_config.access_token rows encrypted by apps/web.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Shared secret for the apps/web -> apps/api server-to-server bridge
# (e.g. the WhatsApp webhook's automations dispatch call). Generate with:
#   openssl rand -hex 32
# Must match apps/web's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=generate-a-long-random-string

# ============================================================
# DOMAIN INTEGRATIONS (Phases 4–5) — set the ones you use
# ============================================================

# Meta (WhatsApp/Facebook) app credentials. META_APP_SECRET is REQUIRED
# for inbound WhatsApp webhooks — signature verification fails closed
# without it, so Meta's POSTs get rejected.
# META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# Public base URL of the dashboard — used for OAuth redirect URIs
# (Shopify callback, Facebook connect) and payment return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay billing (subscription checkout + POST /webhooks/razorpay).
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Stripe billing (checkout session + POST /webhooks/stripe).
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shopify OAuth (ecommerce integration).
# SHOPIFY_CLIENT_ID=your-shopify-client-id
# SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Facebook Lead Ads webhook GET-challenge verify token.
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-verify-token
# NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ------------------------------------------------------------
# Instagram DMs + comment moderation (Instagram Login)
#
# ⚠️ THESE ARE NOT THE SAME VALUES AS META_APP_ID / META_APP_SECRET.
# An "Instagram Login" app is a separate app in the Meta dashboard:
#   Meta → your app → Instagram → API setup with Instagram login
# It has its own App ID and App Secret, and Meta signs Instagram
# webhooks with the *Instagram* secret. Using META_APP_SECRET here
# rejects 100% of inbound webhooks, with no symptom other than
# messages never arriving.
# ------------------------------------------------------------
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Any random string. Must match the "Verify token" field in
# Meta → Instagram → Webhooks exactly. Generate with:
#   openssl rand -hex 16
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your-verify-token

# Must be registered under Business login settings → OAuth Redirect URI.
# Points at the API (not the web app) — same as the webhook.
# INSTAGRAM_REDIRECT_URI=https://your-api-domain/instagram/connect/callback

# Graph version for graph.instagram.com. Pinned so a deprecation is a
# config change, not a deploy.
# INSTAGRAM_API_VERSION=v23.0

# Meta's Human Agent permission extends the reply window from 24 hours
# to 7 days. It is a SEPARATE App Review. Leave false until approved —
# turning it on without approval just makes sends fail at the API.
# INSTAGRAM_HUMAN_AGENT_ENABLED=false

# ============================================================
# RECOMMENDED — safe defaults for local dev
# ============================================================

# docker-compose up starts this at the root of the repo.
REDIS_URL=redis://localhost:6379

PORT=8001
NODE_ENV=development

# BullMQ automations-pending worker concurrency (default 5 if unset).
# AUTOMATIONS_WORKER_CONCURRENCY=5

# Flows stale-run sweep interval in ms (default 5 min).
# FLOWS_SWEEP_INTERVAL_MS=300000

# AI reply tuning + template dry-run switch.
# AI_CONTEXT_MESSAGE_LIMIT=20
# AI_REQUEST_TIMEOUT_MS=30000
# WHATSAPP_TEMPLATES_DRY_RUN=false
