# ============================================================
# apps/web/.env.local  —  PRODUCTION (converse360.in)
#
# Only the domain-dependent values. Leave the Supabase keys and everything else
# as they are.
#
# After editing:  docker compose up -d --build web
#
# THE BUILD-TIME TRAP
#   Every NEXT_PUBLIC_* value is baked into the JS bundle by `next build`, and
#   the rewrite target is baked into routes-manifest.json. Changing anything in
#   this file therefore needs `--build`, not a restart. A plain
#   `docker compose restart web` silently keeps the old values, which presents
#   as "I changed the env and nothing happened".
# ============================================================

NODE_ENV=production

# The app's own public origin. Client-visible.
NEXT_PUBLIC_APP_URL=https://app.converse360.in

# Same misleading name as on the API side — this is the APP origin, used for
# invite links and as the fallback base for the WhatsApp webhook URL the
# dashboard displays. Not the marketing site.
NEXT_PUBLIC_SITE_URL=https://app.converse360.in

# The exact callback string to show operators in Channels → WhatsApp, and the
# one to paste into Meta.
#
# Set explicitly so Meta talks to the API host directly instead of taking the
# app's proxy hop (app.converse360.in/api/whatsapp/webhook → api:8001). Both
# work; the direct route is one less thing between Meta's retry policy and the
# handler, and it keeps webhook traffic off the app container entirely.
NEXT_PUBLIC_WHATSAPP_WEBHOOK_URL=https://api.converse360.in/whatsapp/webhook

# DO NOT SET NEST_API_URL HERE.
#
# docker-compose injects NEST_API_URL=http://api:8001, which keeps the /api/*
# rewrite and all server-side rendering inside the compose network. Setting it
# to https://api.converse360.in would route every internal call out to the
# public internet, through your proxy, and back — and would then fail anyway,
# because the api host only allowlists webhook and v1 paths.
#
# NEXT_PUBLIC_API_URL is likewise unnecessary; the public pages read
# NEST_API_URL first.
