# ============================================================
# apps/api/.env  —  PRODUCTION (converse360.in)
#
# Only the domain-dependent values are listed. Copy these over the equivalents
# in your existing apps/api/.env; leave every secret (DATABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, ENCRYPTION_KEY, META_APP_SECRET, …) exactly as it
# is.
#
# After editing:  docker compose up -d --build api
# ============================================================

NODE_ENV=production
PORT=8001

# Redis is a compose service, reached over the compose network. Not localhost —
# inside the api container, localhost is the container itself.
REDIS_URL=redis://redis:6379


# ------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------

# Where the API builds links that a CUSTOMER will open:
#   - the widget loader src in the install snippet
#   - a form's shareable URL          -> /f/<slug>
#   - a booking page                  -> /book/<slug>
#   - a booking's reschedule link     -> /book/manage/<token>
#   - the send_form / send_booking_link automation steps
#
# All of those are pages the NEXT APP serves, so this is the app host. Pointing
# it at converse360.in would generate links into the static marketing site,
# where every one of them 404s — and they would be 404s already sent to
# customers over WhatsApp.
PUBLIC_APP_URL=https://app.converse360.in

# CAREFUL — the name is misleading.
#
# Despite "SITE", this is the base for TEAM INVITE LINKS (/join/<token>) and is
# the fallback origin for the WhatsApp webhook URL shown in the dashboard. Both
# are app routes. Setting it to https://converse360.in sends every invitation to
# the marketing site.
#
# It is NOT the marketing site's URL. Nothing needs that as an env var.
NEXT_PUBLIC_SITE_URL=https://app.converse360.in

# The Instagram OAuth return. Meta compares this against the registered
# redirect_uri character for character — a trailing slash or http:// fails with
# a generic "couldn't be validated".
#
# On the API host because Meta redirects the browser straight here, bypassing
# the app's /api/* proxy.
INSTAGRAM_REDIRECT_URI=https://api.converse360.in/instagram/connect/callback


# ------------------------------------------------------------
# Web widget
# ------------------------------------------------------------

# Salt for hashing visitor IPs (web_sessions.ip_hash, form_submissions.meta).
# Generate once and never change it: rotating invalidates every stored hash, so
# repeat-visitor and abuse-rate-limit continuity is lost.
#   openssl rand -hex 32
WEB_IP_HASH_SALT=CHANGE_ME_openssl_rand_hex_32

# MUST be false in production.
#
# When true, any loopback Origin bypasses the per-account domain allowlist. The
# default is safe (it requires NODE_ENV === 'development' exactly), but it is
# set explicitly here so nobody has to reason about what an unset NODE_ENV does.
WEB_WIDGET_TRUST_LOCALHOST=false
