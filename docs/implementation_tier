#### [NEW] `apps/api/src/whatsapp/services/messaging-limits-sync.job.ts`

BullMQ repeatable job (named `'sync-messaging-limits'` on a new `'whatsapp-limits'` queue):

```typescript
@Processor('whatsapp-limits')
export class MessagingLimitsSyncJob extends WorkerHost {
  async process(job: Job<{ accountId?: string }>): Promise<void> {
    if (job.data.accountId) {
      // On-demand single account refresh (triggered by the "Refresh" button)
      await this.limitsService.syncAccountLimits(job.data.accountId);
    } else {
      // Scheduled global sweep — paginate to avoid OOM
      const configs = await this.prisma.whatsapp_config.findMany({
        where: { status: 'connected' },
        select: { account_id: true },
      });
      for (const cfg of configs) {
        await this.limitsService.syncAccountLimits(cfg.account_id);
      }
    }
  }
}
```

**Registration in `whatsapp.module.ts`**:
```typescript
BullModule.registerQueue({ name: 'whatsapp-limits' })
```

**Enqueue repeatable job on app bootstrap** (in `MessagingLimitsService.onModuleInit`):
```typescript
await this.limitsQueue.add(
  'global-sync',
  {},
  { repeat: { every: 6 * 60 * 60 * 1000 }, jobId: 'limits-global-sync' }
);
```

