# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace's node_modules)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (apps/web)
.next/
/out/

# nestjs (apps/api)
dist/

# turborepo
.turbo/

# production
/build
# /notes

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never belong in git
.env*
# keep example files so forkers have a template to copy
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/ref
.agents/

# Local docker-compose overrides.
#
# `docker-compose.override.yml` is applied automatically by every
# `docker compose` command, with no flag and no log line. Committing one would
# silently change how the stack runs for everybody — most damagingly by
# republishing a loopback-bound port publicly.
#
# The tracked `.example` beside it is the intended way to share one.
docker-compose.override.yml
docker-compose.*.local.yml
